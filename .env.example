# ==============================================================================
# Application Environment Template
# Duplicate this file as '.env.development' or '.env.test' and fill in values.
# DO NOT commit files containing actual passwords or secrets to Git!
# ==============================================================================

# Google Authorization Configuration
CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
CLIENT_SECRET=your_google_client_secret_here
REDIRECT_URL=http://localhost:8080/auth/google/callback
TOKEN_SECRET=your_32_byte_base64_encoded_token_secret_here

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_local_db_password_here
DB_NAME=chat
DB_SSLMODE=disable
CONTEXT_TIMEOUT=3

# Server Configuration
SERVER_PORT=8080
ENV=development


